# Server Configuration
PORT=5000
NODE_ENV=development

# Set NODE_ENV=production for production deployment
# NODE_ENV=production

# MongoDB Configuration
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/ams

# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ams?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-characters
JWT_EXPIRE=7d

# Rate Limiting (optional overrides)
# AUTH_RATE_LIMIT_WINDOW_MS=900000 (15 minutes)
# AUTH_RATE_LIMIT_MAX=5
# API_RATE_LIMIT_WINDOW_MS=60000 (1 minute)
# API_RATE_LIMIT_MAX=100